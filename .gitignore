# https://dart.dev/guides/libraries/private-files
# Created by `dart pub`
.dart_tool/

# Compiled CUDA kernel (rebuild with: nvcc --shared -Xcompiler -fPIC -o native/lib/libmat_mul.so lib/native/src/engine.cu)
native/lib/*.so
native/lib/*.dll
native/lib/*.dylib

# Face gallery written by bin/train_face_folder.dart (regenerated each run).
faces_gallery/

# Dart pub lockfile — application repo, keep. If you convert this to a library, remove this line to ignore it instead.
# pubspec.lock

# Downloaded pretrained-model weights (large, regenerable).
models/

# COCO val2017 subset fetched by bin/_prep_coco_pairs.dart (32 MB × 200 pairs;
# regenerable — see `bin/_prep_coco_pairs.dart --help`).
data/coco_val*/
data/coco_val_prep/
dist/
models/stockfish/*.nnue

# Local dart_db_server JSON stores + lock files (regenerated per run).
data/*.json
data/*.json.lock

# Local dev dependency override (machine-specific paths)
pubspec_overrides.yaml
